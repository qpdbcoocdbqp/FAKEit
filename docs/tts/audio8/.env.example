# ====================================================================
# Audio8 TTS Docker Compose Environment Variables Configuration
# ====================================================================

# [Model Selection]
# Choose the TTS model to load:
# - Audio8/Audio8-TTS-Preview-0.6b (Default, higher quality)
# - Audio8/Audio8-TTS-Preview-0.1b (Faster, lightweight)
MODEL_NAME=Audio8/Audio8-TTS-Preview-0.6b

# [Model Directory Overrides (Optional)]
# Explicit path to model directory inside container if mounted directly (default is empty, auto-detected from ROOT_MODEL_DIR)
# MODEL_DIR=

# [Host Volume Mount Paths]
# Path to HuggingFace hub cache directory on host
# Linux / macOS default: ~/.cache/huggingface/hub
# Windows default: C:/Users/<username>/.cache/huggingface/hub
HF_CACHE_DIR=~/.cache/huggingface/hub

# Host path to persist registered voices
VOICE_HOST_DIR=./voices
