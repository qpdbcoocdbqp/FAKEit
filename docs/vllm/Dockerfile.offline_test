# Stage 1: Online Preparation
FROM almalinux:8 AS downloader

# Install basic tools required for downloading and building
RUN dnf install -y git wget curl python3 python3-pip cmake gcc-toolset-12 && dnf clean all

WORKDIR /build
RUN mkdir -p ./vllm-offline/wheels/build \
    ./vllm-offline/wheels/runtime \
    ./vllm-offline/wheels/common \
    ./vllm-offline/source \
    ./vllm-offline/cuda \
    ./vllm-offline/torch \
    ./vllm-offline/cutlass \
    ./vllm-offline/triton

WORKDIR /build/vllm-offline

# 1.2 Download vLLM Source Code
RUN git clone https://github.com/vllm-project/vllm.git ./source/vllm

# 1.3 Download CUDA Toolkit (RPM for RHEL/AlmaLinux 8)
RUN wget -q https://developer.download.nvidia.com/compute/cuda/12.9.0/local_installers/cuda-repo-rhel8-12-9-local-12.9.0_575.51.03-1.x86_64.rpm -P ./cuda

# 1.4 Download CUTLASS
RUN git clone https://github.com/nvidia/cutlass.git ./cutlass && \
    cd ./cutlass && git checkout v4.4.2

# 1.5 Download Triton
RUN git clone https://github.com/openai/triton.git ./triton && \
    cd ./triton && git checkout main

# 1.8 Download uv Package Manager script
RUN curl -LsSf https://astral.sh/uv/install.sh -o install_uv.sh

# 1.9 Download a modern CMake (vLLM requires 3.21+)
RUN wget -q https://github.com/Kitware/CMake/releases/download/v3.29.2/cmake-3.29.2-linux-x86_64.tar.gz

# Install uv temporarily in the downloader stage to fetch python packages
ENV PATH="/root/.local/bin:${PATH}"
RUN sh install_uv.sh

# 1.6 Download PyTorch CUDA Wheels
RUN uv pip download torch torchvision torchaudio \
    --python 3.12 \
    --extra-index-url https://download.pytorch.org/whl/cu129 \
    -d ./torch

# 1.7 Download Python Dependencies
RUN python3 -m pip download -r ./source/vllm/requirements/build/cuda.txt -d ./wheels/build && \
    python3 -m pip download -r ./source/vllm/requirements/cuda.txt -d ./wheels/runtime && \
    python3 -m pip download -r ./source/vllm/requirements/common.txt -d ./wheels/common

# Stage 2: Offline Environment
FROM almalinux:8 AS offline_env

# Copy the offline folder to the fresh image
COPY --from=downloader /build/vllm-offline /vllm-offline

WORKDIR /vllm-offline

# Optional: Set an entrypoint to an interactive bash shell
CMD ["/bin/bash"]
