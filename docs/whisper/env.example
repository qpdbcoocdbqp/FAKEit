# ==============================================================================
# Whisper-Streaming & llama.cpp Real-time Subtitle Translation Configuration
# ==============================================================================

# Whisper model size (tiny, base, small, medium, large-v3)
MODEL_SIZE=small

# Compute device (cuda, cpu, auto)
DEVICE=cuda

# Compute precision (float16, int8, float32, auto)
COMPUTE_TYPE=float16

# Streaming refresh interval (seconds)
STREAM_STEP=0.5

# Enable translation (true: load TranslateGemma model to translate into Traditional Chinese; false: output real-time English subtitles only)
ENABLE_TRANSLATE=true

# TranslateGemma / llama-cpp-python model settings
TRANSLATE_MODEL_PATH=%USERPROFILE%/.cache/huggingface/hub/models--SandLogicTechnologies--translategemma-4b-it-GGUF/snapshots/cd39c30302f20fb8b788234d86a0a35a0d050619/translategemma-4b_Q4_K_M.gguf
TRANSLATE_N_CTX=2048
TRANSLATE_N_GPU_LAYERS=-1
